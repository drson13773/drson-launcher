<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0C0A">

    <!-- 1. Thanh tìm kiếm & Tiêu đề ứng dụng -->
    <LinearLayout
        android:id="@+id/headerSearchLayout"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="#161410"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@android:drawable/ic_menu_revert"
            android:tint="#FFF0B8"
            android:padding="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null" />

        <EditText
            android:id="@+id/etSearchQuery"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:background="@android:drawable/editbox_background_normal"
            android:hint="Tìm bài hát, ca sĩ, thể loại (Remix, Chill, Bolero)..."
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true"
            android:imeOptions="actionSearch" />

        <Button
            android:id="@+id/btnSearch"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:text="Tìm kiếm"
            android:textColor="#000000"
            android:backgroundTint="#D4AF37"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 2. Danh sách bài hát dạng lưới 2 cột -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMusicTracks"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@id/headerSearchLayout"
        app:layout_constraintBottom_toTopOf="@id/bottomPlayerBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ProgressBar
        android:id="@+id/pbLoading"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:indeterminateTint="#D4AF37"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/headerSearchLayout"
        app:layout_constraintBottom_toTopOf="@id/bottomPlayerBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 3. Thanh điều khiển phát nhạc cố định ở đáy -->
    <androidx.cardview.widget.CardView
        android:id="@+id/bottomPlayerBar"
        android:layout_width="0dp"
        android:layout_height="72dp"
        app:cardBackgroundColor="#1A1712"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvCurrentTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chưa phát bài hát nào"
                    android:textColor="#FFF0B8"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/tvCurrentArtist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dr Sơn Music - Không Quảng Cáo"
                    android:textColor="#D4AF37"
                    android:textSize="12sp"
                    android:singleLine="true" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btnPlayPause"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:src="@android:drawable/ic_media_play"
                android:tint="#D4AF37"
                android:padding="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@null" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>

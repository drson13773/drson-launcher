<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Theme chính cho Dr. Sơn Launcher - Tối ưu toàn màn hình (Fullscreen Luxury) -->
    <style name="Theme.DrSonLauncher" parent="android:Theme.Material.NoActionBar">
        <!-- Ẩn thanh tiêu đề và thanh tác vụ -->
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        
        <!-- Bật chế độ toàn màn hình cấp hệ thống (che thanh trạng thái Status Bar) -->
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        
        <!-- Màu nền khởi động ban đầu -->
        <item name="android:windowBackground">@android:color/black</item>
        
        <!-- Tối ưu hiển thị cho các màn hình Android hỗ trợ tai thỏ hoặc góc bo tròn -->
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="p">shortEdges</item>
        
        <!-- Màu thanh điều hướng dưới đáy (nếu máy ép hiện) -->
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

</resources>

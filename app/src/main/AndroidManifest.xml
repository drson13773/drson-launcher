<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Quyền hiển thị và quét toàn bộ danh sách app trên Android 11+ -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    
    <!-- Quyền điều khiển cuộc gọi thoại cho Dialer -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    
    <!-- Quyền truy cập Internet để phát nhạc YouTube -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    
    <!-- Quyền phát nhạc chạy nền -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DrSonLauncher">

        <!-- 1. MÀN HÌNH CHÍNH LAUNCHER (Default Home Launcher) -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:clearTaskOnLaunch="true"
            android:stateNotNeeded="true"
            android:theme="@style/Theme.DrSonLauncher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 2. MODULE BÀN PHÍM CUỘC GỌI (Dialer Activity) -->
        <activity
            android:name=".ui.dialer.DialerActivity"
            android:exported="true"
            android:label="Điện thoại"
            android:theme="@style/Theme.DrSonLauncher">
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- 3. MODULE NGHE NHẠC YOUTUBE KHÔNG QUẢNG CÁO (Dr Sơn Music) -->
        <activity
            android:name=".ui.music.DrSonMusicActivity"
            android:exported="true"
            android:label="Dr Sơn Music"
            android:icon="@drawable/icon_music"
            android:theme="@style/Theme.DrSonLauncher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
